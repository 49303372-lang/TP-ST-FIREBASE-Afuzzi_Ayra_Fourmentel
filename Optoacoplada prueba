#define PIN_OPTO 27

void setup() {
  Serial.begin(115200);

  pinMode(PIN_OPTO, INPUT);

  Serial.println("Prueba de entrada optoacoplada PC817C");
}

void loop() {
  int lectura = digitalRead(PIN_OPTO);

  if (lectura == HIGH) {
    Serial.println("SEÑAL 12V DETECTADA");
  } else {
    Serial.println("Sin señal de 12V");
  }

  delay(500);
}
